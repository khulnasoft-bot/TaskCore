FROM ubuntu:24.04

ARG NODE_MAJOR=24
ARG TASKCORE_VERSION=latest
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  TASKCORE_HOME=/taskcore \
  TASKCORE_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3100 \
  HOME=/home/taskcore \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  TASKCORE_VERSION=${TASKCORE_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 taskcore \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 taskcore \
  && mkdir -p /taskcore /home/taskcore/workspace \
  && chown -R taskcore:taskcore /taskcore /home/taskcore \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/taskcore"]
WORKDIR /home/taskcore/workspace
EXPOSE 3100
USER taskcore

# --bind lan is required: `onboard --yes` without an explicit --bind prefers
# trusted-local defaults, which write a loopback bind into the instance config
# and ignore the deployment env vars. A loopback listener inside the container
# is unreachable through Docker's port mapping, so the smoke health check can
# never pass without this flag.
CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$TASKCORE_HOME\"; npx --yes \"taskcore@${TASKCORE_VERSION}\" onboard --yes --bind lan --data-dir \"$TASKCORE_HOME\""]
