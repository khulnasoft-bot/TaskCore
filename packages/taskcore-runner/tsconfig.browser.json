{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@taskcore/taskcore-runner/browser": [
        "src/browser/index.ts"
      ],
      "@taskcore/taskcore-runner/react": [
        "src/react/index.ts"
      ],
      "@taskcore/taskcore-runner/standalone": [
        "src/standalone/index.ts"
      ],
      "@taskcore/taskcore-runner/styles.css": [
        "styles.css"
      ],
      "@taskcore-runner-local/capability": [
        "src/scenarios/index.ts"
      ]
    }
  },
  "include": [
    "devtools/browser/src/**/*.ts",
    "devtools/browser/src/**/*.tsx",
    "devtools/issue-thread/src/**/*.ts",
    "devtools/issue-thread/src/**/*.tsx",
    "examples/*/src/**/*.ts",
    "examples/*/src/**/*.tsx",
    "src/standalone/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
